{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yichen_doc.local/schemas/research_content.schema.json",
  "title": "yichen_doc Shared Research Content Contract",
  "type": "object",
  "required": ["schema_version", "metadata", "decision", "sources", "sections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {
      "type": "object", "required": ["title", "date", "language"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "date": {"type": "string"},
        "language": {"type": "string"},
        "audience": {"type": "string"},
        "confidentiality": {"type": "string"},
        "logo_path": {"type": "string"},
        "cover_image_path": {"type": "string"},
        "cover_image_prompt": {"type": "string"},
        "author": {"type": "string"},
        "theme": {"$ref": "#/$defs/theme"}
      }, "additionalProperties": true
    },
    "decision": {
      "type": "object", "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string"}, "answer": {"type": "string"},
        "owner": {"type": "string"}, "deadline": {"type": "string"},
        "scope": {"type": "string"}, "consequence_of_error": {"type": "string"}
      }, "additionalProperties": true
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "calculations": {"type": "array", "items": {"$ref": "#/$defs/calculation"}},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "theme": {"type": "object", "properties": {"font": {"type": "string"}, "primary": {"type": "string"}, "accent": {"type": "string"}, "muted": {"type": "string"}}, "additionalProperties": true},
    "source": {
      "type": "object", "required": ["id", "title"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "organization": {"type": "string"}, "url": {"type": "string"}, "date": {"type": "string"}, "grade": {"enum": ["A", "B", "C", "D", "E"]}, "limitations": {"type": "string"}, "accessed": {"type": "string"}}, "additionalProperties": true
    },
    "metric": {"type": "object", "required": ["id", "label", "value"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "value": {}, "unit": {"type": "string"}, "period": {"type": "string"}, "source_id": {"type": "string"}, "evidence_type": {"enum": ["FACT", "INTERNAL DATA", "ASSUMPTION", "CALCULATION", "JUDGMENT", "RECOMMENDATION"]}}, "additionalProperties": true},
    "calculation": {"type": "object", "required": ["id", "label", "formula", "unit"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "formula": {"type": "string"}, "excel_formula": {"type": "string"}, "unit": {"type": "string"}, "input_ids": {"type": "array", "items": {"type": "string"}}, "output_metric_id": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "string"}}, "additionalProperties": true},
    "section": {"type": "object", "required": ["id", "title", "blocks"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "conclusion": {"type": "string"}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}}, "additionalProperties": true},
    "block": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["paragraph", "heading", "table", "chart", "metric", "callout", "image", "citation", "formula"]}, "text": {"type": "string"}, "label": {"type": "string"}, "evidence_type": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "headers": {"type": "array", "items": {"type": "string"}}, "rows": {"type": "array", "items": {"type": "array"}}, "chart_type": {"enum": ["bar", "line", "scatter", "pie", "stacked_bar"]}, "categories": {"type": "array"}, "x_values": {"type": "array", "items": {"type": "number"}}, "series": {"type": "array"}, "unit": {"type": "string"}, "formula": {"type": "string"}, "image_path": {"type": "string"}, "alt": {"type": "string"}}, "additionalProperties": true}
  }
}
